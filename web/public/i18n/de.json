  "terms": {
    "ustva": {
      "label": "UStVA",
      "de": "UStVA",
      "explain": "Die regelmäßige Meldung ans Finanzamt, wie viel Umsatzsteuer du berechnet und gezahlt hast."
    },
    "euer": {
      "label": "EÜR",
      "de": "EÜR",
      "explain": "Eine einfache Jahresaufstellung aus Einnahmen minus Ausgaben, die deinen steuerlichen Gewinn zeigt."
    },
    "kleinunternehmer": {
      "label": "Kleinunternehmer",
      "de": "Kleinunternehmer",
      "explain": "Eine Regelung für kleine Unternehmen: Du musst keine Umsatzsteuer berechnen, solange dein Umsatz unter der Grenze bleibt."
    },
    "skr03": {
      "label": "SKR03",
      "de": "SKR03",
      "explain": "Der Standardkontenrahmen mit den Kontonummern, unter denen jede Einnahme und Ausgabe abgelegt wird."
    },
    "eigenbeleg": {
      "label": "Eigenbeleg",
      "de": "Eigenbeleg",
      "explain": "Ein Beleg, den du selbst ausstellst, wenn das Original verloren ging oder es nie einen gab."
    },
    "eingangsbeleg": {
      "label": "Eingangsbeleg",
      "de": "Eingangsbeleg",
      "explain": "Ein Beleg von jemand anderem, zum Beispiel eine Rechnung, die du bezahlst oder bezahlt hast."
    },
    "ausgangsbeleg": {
      "label": "Ausgangsbeleg",
      "de": "Ausgangsbeleg",
      "explain": "Eine Rechnung, die du selbst an einen Kunden gestellt hast."
    }
  },

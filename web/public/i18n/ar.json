{
  "terms": {
    "ustva": {
      "label": "إقرار ضريبة القيمة المضافة",
      "de": "UStVA",
      "explain": "التقرير الدوري لمصلحة الضرائب عن ضريبة القيمة المضافة التي حصّلتها ودفعتها."
    },
    "euer": {
      "label": "تقرير الأرباح السنوي",
      "de": "EÜR",
      "explain": "بيان سنوي بسيط للدخل ناقص المصروفات يوضح ربحك لأغراض الضريبة."
    },
    "kleinunternehmer": {
      "label": "نشاط صغير بدون ضريبة",
      "de": "Kleinunternehmer",
      "explain": "قاعدة للأنشطة الصغيرة تعفيك من تحصيل ضريبة القيمة المضافة ما دامت إيراداتك دون الحد."
    },
    "skr03": {
      "label": "دليل الحسابات",
      "de": "SKR03",
      "explain": "القائمة القياسية لأرقام الحسابات التي يُسجَّل تحتها كل دخل ومصروف."
    },
    "eigenbeleg": {
      "label": "إيصال ذاتي الإصدار",
      "de": "Eigenbeleg",
      "explain": "إيصال تكتبه بنفسك عندما يضيع الأصل أو لا يوجد أصلًا."
    },
    "eingangsbeleg": {
      "label": "مستلم",
      "de": "Eingangsbeleg",
      "explain": "فاتورة أو إيصال صادر عن جهة أخرى، مثل فاتورة دفعتها أو ستدفعها."
    },
    "ausgangsbeleg": {
      "label": "مرسل",
      "de": "Ausgangsbeleg",
      "explain": "فاتورة أصدرتها أنت لعميل."
    },
    "freiberufler": {
      "label": "عمل حر",
      "de": "Freiberufler",
      "explain": "عمل مستقل في مهنة حرة، مثل التصميم أو الاستشارات أو الكتابة أو التدريس. رسالة مصلحة الضرائب توضح نوع نشاطك."
    },
    "gewerbe": {
      "label": "نشاط تجاري",
      "de": "Gewerbe",
      "explain": "نشاط يبيع سلعًا أو خدمات ومسجّل كنشاط تجاري، مثل متجر أو مقهى أو ورشة حرفية. رسالة مصلحة الضرائب توضح نوع نشاطك."
    },
    "dauerfristverlaengerung": {
      "label": "تمديد دائم للمهلة",
      "de": "Dauerfristverlängerung",
      "explain": "موافقة من مصلحة الضرائب تمنحك شهرًا إضافيًا لتقديم إقرار ضريبة القيمة المضافة ودفعها."
    },
    "istVersteuerung": {
      "label": "عندما يدفع عميلي",
      "de": "Ist-Versteuerung",
      "explain": "تستحق عليك ضريبة القيمة المضافة عن البيع بعد أن يدفع لك عميلك، وليس عند إرسال الفاتورة."
    },
    "sollVersteuerung": {
      "label": "عندما أرسل الفاتورة",
      "de": "Soll-Versteuerung",
      "explain": "تستحق عليك الضريبة عن البيع في الشهر الذي ترسل فيه الفاتورة، حتى لو دفع العميل لاحقًا."
    },
    "steuernummer": {
      "label": "الرقم الضريبي",
      "de": "Steuernummer",
      "explain": "الرقم الذي منحته مصلحة الضرائب لنشاطك. تجده في أعلى رسائلها."
    },
    "ustIdNr": {
      "label": "رقم ضريبة القيمة المضافة",
      "de": "USt-IdNr.",
      "explain": "رقم التعريف الأوروبي لضريبة القيمة المضافة. يبدأ بـ DE ويتبعه تسعة أرقام. لا يكون لديك إلا إذا طلبته، فيمكنك تركه فارغًا."
    },
    "finanzamt": {
      "label": "مصلحة الضرائب",
      "de": "Finanzamt",
      "explain": "المكتب المحلي الذي يتولى ضرائبك. اسمه مكتوب على رسائله."
    },
    "umsatzsteuer": {
      "label": "ضريبة القيمة المضافة التي حصّلتها",
      "de": "Umsatzsteuer",
      "explain": "ضريبة القيمة المضافة التي أضفتها إلى فواتير مبيعاتك. تحوّلها إلى مصلحة الضرائب بعد خصم ضريبة القيمة المضافة التي دفعتها أنت."
    },
    "vorsteuer": {
      "label": "ضريبة القيمة المضافة التي دفعتها",
      "de": "Vorsteuer",
      "explain": "ضريبة القيمة المضافة الموجودة في الفواتير التي دفعتها لنشاطك. تخصمها من ضريبة القيمة المضافة التي حصّلتها."
    },
    "elster": {
      "label": "التقديم الضريبي عبر الإنترنت",
      "de": "ELSTER",
      "explain": "إلستر هي القناة الإلكترونية الرسمية لمصلحة الضرائب. ما ترسله عبرها يصل إليها مباشرة."
    },
    "einkommensteuererklaerung": {
      "label": "إقرار ضريبة الدخل",
      "de": "Einkommensteuererklärung",
      "explain": "إقرارك الضريبي الشخصي السنوي. تذكر فيه كل دخلك الخاضع للضريبة، ومنه ربح نشاطك."
    },
    "feststellungserklaerung": {
      "label": "إقرار أرباح الشراكة",
      "de": "Feststellungserklärung",
      "explain": "إقرار الشراكة، مثل GbR. يبيّن ربح النشاط وكيفية توزيعه بين الشركاء، ويذكر كل شريك حصته في إقراره الشخصي لضريبة الدخل."
    },
    "umsatzsteuererklaerung": {
      "label": "إقرار ضريبة القيمة المضافة السنوي",
      "de": "Umsatzsteuererklärung",
      "explain": "الملخص السنوي لكل ضريبة القيمة المضافة لديك، يُقدَّم بعد الإقرارات الشهرية أو الربع سنوية."
    },
